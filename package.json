{
  "name": "varde",
  "description": "Variant Designsystem: Varde",
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "bun --filter '*' build",
    "build:docs": "bun --filter '@varde/*' build",
    "dev": "bun --filter '@varde/css' dev & bun --filter '@varde/docs' dev & wait",
    "dev:agent": "bun scripts/dev-agent.ts",
    "dev:stop": "bun scripts/dev-stop.ts",
    "format": "bunx --bun @biomejs/biome format --write",
    "check": "bunx --bun @biomejs/biome check && tsc --noEmit",
    "fix": "bunx --bun @biomejs/biome check --write"
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "catalog": {
    "@biomejs/biome": "2.4.3",
    "typescript": "^5.9.3",
    "@types/bun": "latest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/bun": "^1.3.10"
  }
}
